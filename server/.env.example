# Porta do servidor de email
PORT=4000

# Configuração SMTP (Gmail)
# Para Gmail, ative 2FA e gere um App Password em:
# Google Conta > Segurança > Senhas de App
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email@gmail.com
SMTP_PASS=seu_app_password

# (Opcional) Resend como fallback
# Obtenha a chave em https://resend.com/
RESEND_API_KEY=